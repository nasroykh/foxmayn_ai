# One build context (repo root) serves all three Dockerfiles.

# Dependencies and build output (rebuilt inside the image)
node_modules
**/node_modules
.pnpm-store
dist
**/dist
build
**/build
.turbo
**/.turbo
**/*.tsbuildinfo
coverage
**/.nyc_output

# Secrets and local environment (never bake into an image)
.env
.env.*
**/.env
**/.env.*
!.env.example

# VCS, CI, editors, agent tooling
.git
.gitignore
.github
.gitlab-ci.yml
.vscode
.idea
.DS_Store
*.swp
*~
.claude
**/.claude
.cursor
**/.cursor
.agent
.agents
skills-lock.json

# Tests and docs are not needed to build
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
*.md
**/*.md

# Logs and misc
*.log
tmp
temp
*.zip
*.tar.gz
