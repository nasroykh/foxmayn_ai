# ============================================================
# Single env file for local dev (pnpm dev) and Docker Compose.
#   cp .env.example .env     (or: make env-setup)
#
# Replace every CHANGE_ME. Production refuses CHANGE_ME values.
#   Secrets:             openssl rand -base64 48
#   Passwords in URLs:   openssl rand -hex 24   (hex is URL-safe)
# Do not use the characters $ or " in values: Docker Compose interpolates them.
#
# Docker Compose builds DB_URL, REDIS_URL and QDRANT_URL for the containers
# from POSTGRES_*, REDIS_PASSWORD and QDRANT_API_KEY; the *_URL values below
# are used only by `pnpm dev` / `pnpm db:migrate` on the host.
# ============================================================

# ---------- Core (api, worker) ----------
# development | production (Compose always sets production)
NODE_ENV=development
# Public origin users open in the browser (no trailing slash).
# Production example: https://ai.example.com
APP_URL=http://localhost:33460
# Session signing secret, min 32 chars.
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_base64_48
# Super admin created on first start.
SUPER_ADMIN_EMAIL=admin@example.com
# Min 12 chars.
SUPER_ADMIN_PASSWORD=CHANGE_ME_admin_password

# ---------- API server (api, worker; optional, defaults shown) ----------
# PORT=33450
# HOST=0.0.0.0
# API_V1_PREFIX=/api/v1

# ---------- Frontend (build time) ----------
# Same-origin API path. Production: Caddy proxies /api/* to the API.
# Dev: the Vite dev server proxies /api to http://localhost:33450.
VITE_API_URL=/api/v1

# ---------- PostgreSQL ----------
# Read by the postgres container and used to build DB_URL in Compose.
POSTGRES_USER=foxmayn_ai
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=foxmayn_ai
# Host-side URL for `pnpm dev` and `pnpm db:migrate` (keep the password in sync).
DB_URL=postgresql://foxmayn_ai:CHANGE_ME_openssl_rand_hex_24@localhost:5432/foxmayn_ai

# ---------- Redis ----------
# Compose starts Redis with this password.
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_24
# Host-side URL for `pnpm dev` (keep the password in sync).
REDIS_URL=redis://:CHANGE_ME_openssl_rand_hex_24@localhost:6379

# ---------- Qdrant ----------
# Compose starts Qdrant with this API key. Required by Compose, optional in code.
QDRANT_API_KEY=CHANGE_ME_openssl_rand_hex_24
# Host-side URL for `pnpm dev`.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documents

# ---------- SMTP (OTP and invitation emails) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_smtp_user
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM=no-reply@example.com

# ---------- LLM ----------
OPENROUTER_API_KEY=CHANGE_ME_sk-or-v1-...

# ---------- Docker Compose only ----------
# Interface and port the app container (Caddy) is published on. Put your
# TLS proxy (Traefik/Pangolin) in front of it. 0.0.0.0 exposes plain HTTP.
# BIND=127.0.0.1
# APP_PORT=33460
# Loopback-only host ports of the data stores (for local dev tools).
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# QDRANT_HOST_PORT=6333
# Image tag for built images (default: latest).
# IMAGE_TAG=latest
