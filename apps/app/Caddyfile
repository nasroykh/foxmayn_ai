# Serves the built SPA and reverse-proxies /api/* to the API container.
# TLS is terminated upstream (Cloudflare + Traefik/Pangolin); this listens on plain HTTP.
{
	admin off
	auto_https off

	servers {
		# Keep X-Forwarded-* from the upstream proxy (Traefik) when it comes from a
		# private address, so the API sees the real client IP and https scheme.
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

(security_headers) {
	header {
		# max-age only, no includeSubDomains/preload: TLS is managed upstream.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# Content-Security-Policy for the SPA only (not for API responses).
# style-src 'unsafe-inline': React style attributes, sonner and the recharts chart <style>.
# img-src/font-src data: : small assets inlined by Vite.
(spa_headers) {
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
}

:33460 {
	log {
		output stderr
		format console
	}

	import security_headers

	# Errors (e.g. a missing /assets file, API down): never cacheable, same security headers.
	handle_errors {
		import security_headers
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}

	# Docker healthcheck
	handle /health {
		log_skip
		respond "healthy" 200
	}

	# API: no compression and immediate flushing so streamed (chat) responses
	# reach the browser token by token.
	handle /api/* {
		request_body {
			# API limit is 11 MB (apps/api/src/plugins/index.ts)
			max_size 12MB
		}
		reverse_proxy api:33450 {
			# Overwrites any client-supplied value; the API rate limiter reads only this
			header_up X-Real-IP {client_ip}
			flush_interval -1
			transport http {
				dial_timeout 5s
			}
		}
	}

	# Vite hashed assets: immutable for a year. A missing file is a real 404,
	# never the SPA fallback (a stale hash must not return HTML as JS/CSS).
	handle /assets/* {
		import spa_headers
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		encode zstd gzip
		file_server
	}

	# SPA: index.html (and any client-side route) must always revalidate.
	handle {
		import spa_headers
		header Cache-Control "no-cache"
		root * /srv
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}
