		"@hono/node-server": "^2.1.5",
		"@langchain/textsplitters": "^1.0.2",
		"@orpc/openapi": "^1.16.1",
		"@orpc/server": "^1.16.1",
		"@orpc/zod": "^1.16.1",
		"@repo/db": "workspace:*",
		"@repo/llm": "workspace:*",
		"@repo/qdrant": "workspace:*",
		"@scalar/hono-api-reference": "^0.12.14",
		"ajv": "^8.20.0",
		"better-auth": "^1.7.12",
		"bullmq": "^6.4.1",
		"dotenv": "^18.0.9",
		"drizzle-orm": "^0.45.4",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.13.13",
		"ioredis": "^6.0.0",
		"js-tiktoken": "^1.0.21",
		"mammoth": "^1.13.0",
		"nodemailer": "^10.2.1",
		"pdf-parse": "^2.4.5",
		"pg": "^8.23.1",
		"turndown": "^7.2.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/tsconfig": "workspace:*",
		"@types/node": "^24.19.2",
		"@types/turndown": "^5.0.6",
		"eslint": "^10.13.0",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3"
	}
