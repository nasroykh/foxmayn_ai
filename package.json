{
	"name": "foxmayn_ai",
	"private": true,
	"license": "MIT",
	"version": "0.0.0",
	"packageManager": "pnpm@10.34.9",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"start": "turbo run start",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"clean": "rm -rf node_modules .turbo apps/*/node_modules apps/*/dist apps/*/.turbo packages/*/node_modules packages/*/dist packages/*/.turbo",
		"auth:generate": "cd apps/api && npx auth@latest generate --config src/config/auth.ts --output ../../packages/db/src/models/auth/schema.ts",
		"db:generate": "turbo run db:generate --filter=@repo/db",
		"db:migrate": "turbo run db:migrate --filter=@repo/db",
		"db:push": "turbo run db:push --filter=@repo/db",
		"db:studio": "turbo run db:studio --filter=@repo/db",
		"models:generate": "turbo run models:generate --filter=@repo/llm",
		"models:eval-multilingual": "pnpm --filter @repo/llm models:eval-multilingual"
	},
	"devDependencies": {
		"turbo": "^2.11.10"
	},
	"engines": {
		"node": ">=24"
	}
}
