{
	"name": "@repo/llm",
	"version": "0.0.0",
	"description": "OpenRouter SDK wrapper (chat, streaming, embeddings) and model price list",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./openrouter": {
			"types": "./src/openrouter.ts",
			"default": "./dist/openrouter.js"
		},
		"./openrouter/models": {
			"types": "./src/data/openrouter_models.ts",
			"default": "./dist/data/openrouter_models.js"
		}
	},
	"scripts": {
		"dev": "tsc --watch --preserveWatchOutput",
		"build": "rimraf dist && tsc",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"models:generate": "tsx src/scripts/generate_model_list.ts",
		"models:eval-multilingual": "tsx src/scripts/multilingual_eval.ts"
	},
	"license": "MIT",
	"dependencies": {
		"@openrouter/sdk": "^1.5.7",
		"dotenv": "^18.0.9",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/tsconfig": "workspace:*",
		"@types/node": "^24.19.2",
		"eslint": "^10.13.0",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3"
	},
	"private": true,
	"files": [
		"dist"
	]
}
